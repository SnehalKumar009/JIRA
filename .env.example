# Template for .env — create the real file with scripts/init-env.sh, which replaces every
# CHANGE_ME with a generated secret. Never commit .env.

# Image tag for locally built images (tracker-app, tracker-keycloak).
TRACKER_IMAGE_TAG=local

# HTTPS port for https://tracker.test and https://auth.test. Used inside the containers as well,
# so changing it later also changes the Keycloak issuer URL.
TRACKER_HTTPS_PORT=8443

# PostgreSQL superuser (used only by init, backup and restore) and per-service roles.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
TRACKER_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# Keycloak bootstrap admin — temporary, for first start and emergencies only.
KEYCLOAK_ADMIN_USERNAME=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Shared secret between the app and its Keycloak client (tracker-app).
TRACKER_OIDC_CLIENT_SECRET=CHANGE_ME

# Observability profile only: Grafana admin and the desktop ports for each UI.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3300
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686

# Set to true while the observability profile is running, so the app exports traces to Jaeger.
TRACING_EXPORT_ENABLED=false
