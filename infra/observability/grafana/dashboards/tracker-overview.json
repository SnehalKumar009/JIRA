{
  "uid": "tracker-overview",
  "title": "Tracker overview",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{job=\"tracker-app\"}[5m]))", "legendFormat": "{{status}} {{uri}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95 (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"tracker-app\"}[5m])))", "legendFormat": "{{uri}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used (bytes)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{job}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB connections (active / idle)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"tracker-app\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{job=\"tracker-app\"}", "legendFormat": "idle" }
      ]
    }
  ]
}
